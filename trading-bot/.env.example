# Is file ko copy karke .env banao:  cp .env.example .env
# .env kabhi GitHub par push mat karna (.gitignore mein hai).
# API key banate waqt: sirf "Trading" permission, "Withdrawal" kabhi nahi. IP whitelist lagao.

DELTA_API_KEY=
DELTA_API_SECRET=

COINDCX_API_KEY=
COINDCX_API_SECRET=

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Asli trading ke liye hi YES karo
LIVE_TRADING=NO
